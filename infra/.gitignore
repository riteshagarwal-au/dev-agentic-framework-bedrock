# Local Terraform working directory and provider cache — never committed.
**/.terraform/*

# Terraform state and its backups — never committed (state lives in the S3 backend, Task 2.1).
*.tfstate
*.tfstate.*

# Crash log files.
crash.log
crash.*.log

# Local override files — never committed, may contain secrets.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files that may contain credentials.
.terraformrc
terraform.rc
